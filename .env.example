# Copy to .env and replace password placeholders before running the services.
# The integrated Docker Compose configuration will be added in source batch 3.

# MariaDB and the Flask database account
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DATABASE_ROOT_PASSWORD
APP_DB_USER=appuser
APP_DB_PASSWORD=REPLACE_WITH_APP_DATABASE_PASSWORD
DB_BIND=127.0.0.1

# Keycloak bootstrap administrator
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=REPLACE_WITH_KEYCLOAK_ADMIN_PASSWORD
KC_REALM=realm_523H0145

# Before the first realm import, replace the SV01 and SV02 password placeholders
# in authentication-identity-server/import/realm_523H0145.json locally.
# Keep actual passwords out of commits. KC_ADMIN_PASSWORD does not set user passwords.
