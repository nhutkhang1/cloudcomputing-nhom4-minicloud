# Environment configuration example

# Docker account configuration
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=latest

# Docker network configuration
CLOUD_PREFIX=10.10.10

# MariaDB configuration
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DATABASE_ROOT_PASSWORD
APP_DB_USER=appuser
APP_DB_PASSWORD=REPLACE_WITH_APP_DATABASE_PASSWORD
DB_BIND=127.0.0.1

# Keycloak configuration
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=REPLACE_WITH_KEYCLOAK_ADMIN_PASSWORD
KC_REALM=realm_523H0145

# MinIO configuration
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ADMIN_PASSWORD

# MinIO storage ownership
HOST_UID=1000
HOST_GID=1000

# Grafana configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_ADMIN_PASSWORD
